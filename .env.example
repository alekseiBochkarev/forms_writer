# ===== Настройки модели (LLM) =====
# API-ключ модели (OpenAI, AITunnel, OpenRouter и любой OpenAI-совместимый провайдер)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.8
# Таймаут одного LLM-запроса, секунд
LLM_TIMEOUT=120
# Число повторных попыток поверх первой (всего до LLM_RETRIES+1 транзиентных
# запросов: таймауты, 429, 5xx). При ответах 400/404/415/422 один раз
# дополнительно отправляется запрос без response_format — вне retry-бюджета.
LLM_RETRIES=1
# Базовая пауза перед повтором, секунд (экспоненциально: 5s, 10s, ...)
LLM_RETRY_DELAY=5.0

# ===== Настройки Яндекс Форм =====
# OAuth-токен с правом forms:write
YANDEX_FORMS_TOKEN=
# Идентификатор организации (значение для заголовка X-Cloud-Org-Id или X-Org-Id)
YANDEX_ORG_ID=
# Какой заголовок использовать: X-Cloud-Org-Id (по умолчанию) или X-Org-Id
YANDEX_ORG_HEADER=X-Cloud-Org-Id
# Если задан — вопросы добавятся в существующую форму (иначе создаётся новая)
# YANDEX_SURVEY_ID=

# ===== Содержание теста =====
QUESTIONS_TOPIC=общая эрудиция: разные области науки и жизни
QUESTIONS_COUNT=13
QUESTIONS_LANGUAGE=ru
# Название формы; {date} не подставляется, дата добавляется автоматически по умолчанию
SURVEY_NAME=Насколько широк ваш кругозор

# ===== Поведение =====
PUBLISH=true
# Добавлять к названию формы счётчик: 2, 3, 4, ...
NUMBER_SURVEYS=true
SHUFFLE=true
SHOW_RESULTS=true
SHOW_CORRECT=true
STATS=true
# Порог прохождения: используется в названии тематических тестов, в форме всегда сегменты
# PASS_SCORES=7
# Свои сегменты результатов (JSON-массив). Если не задано — строятся автоматически.
# SEGMENTS=[{"title":"Новичок","description":"...","upper_limit":4},{"title":"Эрудит","description":"...","upper_limit":13}]
# Удалять уже существующие вопросы в форме перед добавлением
CLEAR_EXISTING=false
# JSON-файл с готовыми вопросами (тогда LLM не вызывается)
# QUESTIONS_FILE=samples/questions.json
# Не обращаться к Яндекс Формам (только показать план)
DRY_RUN=false

# ===== Вводная/заключительная части и ревью =====
# Генерировать вводную (2-4 абзаца) и заключительную (1-3 абзаца) части.
# Вводная вставляется блоком comment в начале формы, заключительная — в конце.
INTRO_ENABLED=true
CONCLUSION_ENABLED=true
INTRO_MIN_PARAGRAPHS=2
INTRO_MAX_PARAGRAPHS=4
OUTRO_MIN_PARAGRAPHS=1
OUTRO_MAX_PARAGRAPHS=3
# Обязательное ревью (отдельный LLM-проход) перед публикацией.
REVIEW_ENABLED=true
# Сколько регенераций делать, если ревью не прошло (0 — без повторов).
REVIEW_MAX_ATTEMPTS=1
# Модель ревью; пусто — используется LLM_MODEL.
REVIEW_MODEL=
# Добавлять вводную в текст Telegram-анонса (перед ссылкой/CTA).
ANNOUNCE_INTRO=true

# ===== Факт-чекинг вопросов =====
# Отдельный LLM-проход: проверяет достоверность правильных ответов и
# отбрасывает вопросы с неверными/двусмысленными фактами. При сбое LLM
# вопросы не отбрасываются, выпуск не блокируется.
FACTCHECK_ENABLED=true
# Модель факт-чека; пусто — используется REVIEW_MODEL или LLM_MODEL.
FACTCHECK_MODEL=

# ===== Публикация анонса в Telegram и VK =====
# Публиковать анонс в Telegram (нужны TG_BOT_TOKEN и TG_TARGET_CHANNEL)
PUBLISH_TELEGRAM=true
# Токен бота, который является администратором канала. Один бот для всех
# каналов: для @qa_helper_draft это бот qa_helper_editor (@BotFather -> API token).
TG_BOT_TOKEN=
# Канал СТАРОГО потока (эрудиция и фото). Bot API принимает @username или -100...
# Новый поток использует свой канал ниже (NEW_TESTS_TG_TARGET_CHANNEL).
TG_TARGET_CHANNEL=
# VK не используем.
PUBLISH_VK=false
VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Формулировки анонса. Доступны {name}, {count}, {url}, {date}.
# Если ничего не задано — используется встроенный набор, и при каждом запуске
# выбирается случайная формулировка (посты в TG/VK слегка отличаются).
# Одна своя формулировка (многострочная — в кавычках с \n):
# ANNOUNCE_TEMPLATE="Новый тест: «{name}»\n\n{count} вопросов. Пройти: {url}"
# Или список из нескольких (JSON) — тогда выбирается случайная:
# ANNOUNCE_TEMPLATES=["Вариант А: «{name}» — {url}","Вариант Б ({count} вопросов): {url}"]

# ===== Состояние =====
# Файл состояния (защита от повторной публикации в один день)
STATE_FILE=state.json
# Игнорировать защиту от дублей
FORCE=false

# ===== Фото-тесты (отдельный поток) =====
# Обязательный гейт фото-потока: пока не true, `python main.py --photo` не запускается
PHOTO_FLOW_ENABLED=false
PHOTO_SURVEY_NAME=Что на фото
PHOTO_QUESTIONS_COUNT=10
# Зафиксировать тему выпуска (иначе выбирается случайная неиспользованная)
# PHOTO_THEME=советские фильмы
# Темы (JSON-массив). Если не задано — встроенный список тем.
# PHOTO_THEMES=["советские фильмы","советские актёры","советские актрисы","породы собак","картины из школьной программы"]
# Источники изображений (JSON-массив). Задаёт только открытые wikimedia/openverse.
# Кино-источники (ruwiki_film/filmgrab/movscreencaps) здесь НЕ включаются —
# только соответствующими флагами ниже; имена кино-источников в этом списке
# ни на что не влияют.
# PHOTO_SOURCES=["wikimedia","openverse"]
PHOTO_MAX_IMAGE_ATTEMPTS=3
# Минимум вопросов, при котором выпуск считается состоявшимся (None — равен PHOTO_QUESTIONS_COUNT)
# PHOTO_MIN_QUESTIONS=10
PHOTO_IMAGE_TIMEOUT=30
PHOTO_IMAGE_MAX_BYTES=8000000
PHOTO_STATE_FILE=photo_state.json
# Библиотека заголовков фото-тестов (JSON-объект: категория -> массив шаблонов).
# {count} — число вопросов. Если не задано — используется встроенная библиотека.
# PHOTO_TITLE_TEMPLATES={"советские фильмы":["Узнайте фильм по кадру. {count} вопросов"]}
# Сколько последних заголовков не повторять (по умолчанию 10).
PHOTO_TITLE_HISTORY=10
# Wikimedia требует осмысленный User-Agent (обязателен для источника wikimedia)
WIKIMEDIA_USER_AGENT=
OPENVERSE_API_KEY=
OPENVERSE_BASE_URL=https://api.openverse.org/v1
# Кино-источники (по умолчанию выключены: рискованные по правам/лицензиям).
# Советские фильмы, актёры и актрисы ищутся в ru.wikipedia только при FILM_RU_ENABLED=true;
# иностранные фильмы — на film-grab/movie-screencaps при соответствующих флагах.
# Без этих флагов кино-темы пропускаются.
# Экспериментально включено для нового проекта (канал qa_helper_draft); при
# успешном создании выпусков включим и в остальных потоках.
FILM_RU_ENABLED=true
FILM_GRAB_ENABLED=false
MOVIE_SCREENCAPS_ENABLED=false
# Vision-проверка изображений (включена по умолчанию, fail-closed: неподходящие
# и неопознанные изображения не попадают в выпуск). Нужна vision-совместимая модель.
PHOTO_VISION_ENABLED=true
# Если не заданы — используются LLM_API_KEY / LLM_BASE_URL / LLM_MODEL
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TIMEOUT=120

# ===== Поток «новых тестов» (отдельный канал) =====
# Обязательный гейт потока: пока не true, `python main.py --new-tests` не запускается.
NEW_TESTS_ENABLED=false
# 15 вопросов с порогом 10/15 (решение заказчика).
NEW_TESTS_COUNT=15
# Порог(и) прохождения: одно число или список (JSON-массив / «7,8»).
# По умолчанию 10 баллов из 15.
# NEW_TESTS_PASS_SCORES=[10]
NEW_TESTS_MIN_QUESTIONS=15
# Темы потока (JSON-массив). Если не задано — встроенный список (общая
# эрудиция + популярные направления: кино, актёры, сказки, кулинария и т.д.).
# Спецтема «творческая личность» даёт отдельный выпуск об одной узнаваемой
# личности (выбирается из списка NEW_TESTS_PERSONALITIES с ротацией).
# NEW_TESTS_TOPICS=["общая эрудиция","творческая личность","советское кино","кулинария"]
NEW_TESTS_SURVEY_NAME=Насколько широк ваш кругозор
# Список деятелей искусства для тематических выпусков «творческая личность».
# Если не задано — встроенный список (Шаляпин, Врубель, Чайковский и др.).
# NEW_TESTS_PERSONALITIES=["Фёдор Шаляпин","Михаил Врубель","Пётр Чайковский"]
# Сколько вопросов о творческих личностях подмешивать в общий тест эрудиции
# (0 — выключить).
PERSONALITY_MIX_COUNT=1
NEW_TESTS_STATE_FILE=new_state.json
# Канал Telegram для нового потока. Должен быть @username (Bot API не принимает web-id).
NEW_TESTS_TG_TARGET_CHANNEL=@qa_helper_draft
# Отдельный токен бота для нового потока; пусто — используется TG_BOT_TOKEN
# (тот же бот qa_helper_editor).
NEW_TESTS_TG_BOT_TOKEN=
NEW_TESTS_PUBLISH_TELEGRAM=true
NEW_TESTS_PUBLISH_VK=false

# ===== Эксперимент с рубриками тестов =====
# Реестр рубрик (JSON-массив объектов). Если не задано — встроенный список из
# трёх рубрик: «a» Знаток по кино (фото, 8 вопросов, порог 6), «b» Знаток по
# фото (фото, 10/8), «c» Ловушка (trap, 10/8).
# Поля: id, series_name, source ("photo" | "trap"), questions_count, threshold
# (обязательно меньше questions_count), title_templates (массив шаблонов с
# плейсхолдерами {series_no}, {threshold}, {count}, {n}), comment_prompt
# (вопрос для комментариев в конце формы), enabled, slot (время CI-слота).
# RUBRICS=[{"id":"a","series_name":"Знаток по кино","source":"photo","questions_count":8,"threshold":6,"title_templates":["{threshold} из {count} — вы знаток кино {series_no}"],"comment_prompt":"Ваш любимый фильм?","enabled":true,"slot":"morning"}]
# Файл состояния рубрик (номера серий и даты публикаций на рубрику)
RUBRICS_STATE_FILE=rubrics_state.json
# Порог вердикта «ниже порога» в rubric_metrics.py: по медиане ЧИСЛА ОТВЕТОВ
# формы за 7 дней (прокси просмотров — просмотров API Яндекс Форм не отдаёт).
# Пустое или нечисловое значение — используется 50.
RUBRIC_MIN_MEDIAN=50
# Репак провала (python main.py --rubric c --repack): доля ошибшихся wrong_pct,
# при которой публикация считается провальной и переупаковывается с новым
# заголовком (те же вопросы). По умолчанию 60.
RUBRIC_REPACK_WRONG_PCT=60
# Минимум ответов формы, при котором метрика считается достаточной для репака.
RUBRIC_REPACK_MIN_ANSWERS=10
